<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="https://schemas.example.test/learning/v1" targetNamespace="https://schemas.example.test/learning/v1" elementFormDefault="qualified">
  <xs:annotation><xs:documentation>Course enrollment, learner progress, and module results.</xs:documentation></xs:annotation>
  <xs:simpleType name="CourseKey"><xs:annotation><xs:documentation>Course catalog identifier.</xs:documentation></xs:annotation><xs:restriction base="xs:string"><xs:minLength value="4"/><xs:maxLength value="18"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="EnrollmentState"><xs:annotation><xs:documentation>Learner enrollment status.</xs:documentation></xs:annotation><xs:restriction base="xs:string"><xs:enumeration value="enrolled"/><xs:enumeration value="inProgress"/><xs:enumeration value="completed"/><xs:enumeration value="withdrawn"/></xs:restriction></xs:simpleType>
  <xs:complexType name="ModuleResultType"><xs:annotation><xs:documentation>Completion and score for one course module.</xs:documentation></xs:annotation><xs:sequence><xs:element name="moduleKey" type="xs:string"/><xs:element name="score" type="xs:decimal" minOccurs="0"><xs:annotation><xs:documentation>Score on a zero-to-one-hundred scale.</xs:documentation></xs:annotation></xs:element><xs:element name="completedAt" type="xs:dateTime" minOccurs="0"/></xs:sequence><xs:attribute name="attempt" type="xs:positiveInteger" use="required"/><xs:attribute name="passed" type="xs:boolean" default="false"/></xs:complexType>
  <xs:complexType name="EnrollmentType"><xs:annotation><xs:documentation>Course registration and learner progress summary.</xs:documentation></xs:annotation><xs:sequence><xs:element name="course" type="tns:CourseKey"/><xs:element name="learnerRef" type="xs:string"/><xs:element name="result" type="tns:ModuleResultType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence><xs:attribute name="state" type="tns:EnrollmentState" use="required"/><xs:attribute name="startedOn" type="xs:date" use="required"/><xs:attribute name="instructor" type="xs:string"/></xs:complexType>
  <xs:element name="enrollment" type="tns:EnrollmentType"><xs:annotation><xs:documentation>Learner enrollment record.</xs:documentation></xs:annotation></xs:element>
</xs:schema>