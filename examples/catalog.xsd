<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:tns="https://schemas.example.test/catalog/v1"
  targetNamespace="https://schemas.example.test/catalog/v1" elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>Product catalog entries, pricing, and classification.</xs:documentation>
  </xs:annotation>
  <xs:simpleType name="SkuCode">
    <xs:annotation>
      <xs:documentation>Catalog stock-keeping identifier.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="SKU-[A-Z0-9]{5,10}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ProductStatus">
    <xs:annotation>
      <xs:documentation>Publication state for an item.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="draft" />
      <xs:enumeration value="listed" />
      <xs:enumeration value="retired" />
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="PriceType">
    <xs:annotation>
      <xs:documentation>Amount and currency for a catalog price.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="amount" type="xs:decimal">
        <xs:annotation>
          <xs:documentation>Unit price in the stated currency.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="currency" type="xs:string" />
    </xs:sequence>
    <xs:attribute name="taxIncluded" type="xs:boolean" use="required" />
    <xs:attribute name="tier" type="xs:string" default="standard" />
  </xs:complexType>
  <xs:complexType name="ProductType">
    <xs:annotation>
      <xs:documentation>Descriptive product record and current price.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="sku" type="tns:SkuCode">
        <xs:annotation>
          <xs:documentation>Stable item identifier.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="title" type="xs:string">
        <xs:annotation>
          <xs:documentation>Short customer-facing title.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="description" type="xs:string" minOccurs="0" />
      <xs:element name="price" type="tns:PriceType" />
    </xs:sequence>
    <xs:attribute name="status" type="tns:ProductStatus" use="required" />
    <xs:attribute name="category" type="xs:string" use="required" />
    <xs:attribute name="stockTracked" type="xs:boolean" default="true" />
  </xs:complexType>
  <xs:element name="product" type="tns:ProductType">
    <xs:annotation>
      <xs:documentation>Top-level catalog item.</xs:documentation>
    </xs:annotation>
  </xs:element>
</xs:schema>