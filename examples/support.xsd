<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="https://schemas.example.test/support/v1" targetNamespace="https://schemas.example.test/support/v1" elementFormDefault="qualified">
  <xs:annotation><xs:documentation>Customer service cases, messages, and resolution details.</xs:documentation></xs:annotation>
  <xs:simpleType name="CaseNumber"><xs:annotation><xs:documentation>Support case reference displayed to customers.</xs:documentation></xs:annotation><xs:restriction base="xs:string"><xs:pattern value="CASE-[0-9]{7}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="CasePriority"><xs:annotation><xs:documentation>Queue priority assigned to a case.</xs:documentation></xs:annotation><xs:restriction base="xs:string"><xs:enumeration value="low"/><xs:enumeration value="normal"/><xs:enumeration value="high"/><xs:enumeration value="urgent"/></xs:restriction></xs:simpleType>
  <xs:complexType name="MessageType"><xs:annotation><xs:documentation>One chronological case conversation entry.</xs:documentation></xs:annotation><xs:sequence><xs:element name="author" type="xs:string"/><xs:element name="body" type="xs:string"><xs:annotation><xs:documentation>Message text with line breaks preserved by the application.</xs:documentation></xs:annotation></xs:element><xs:element name="sentAt" type="xs:dateTime"/></xs:sequence><xs:attribute name="visibility" type="xs:string" use="required"/><xs:attribute name="attachmentCount" type="xs:nonNegativeInteger" default="0"/></xs:complexType>
  <xs:complexType name="CaseType"><xs:annotation><xs:documentation>Support request, ownership, and conversation history.</xs:documentation></xs:annotation><xs:sequence><xs:element name="number" type="tns:CaseNumber"/><xs:element name="subject" type="xs:string"/><xs:element name="message" type="tns:MessageType" minOccurs="1" maxOccurs="unbounded"/><xs:element name="resolution" type="xs:string" minOccurs="0"/></xs:sequence><xs:attribute name="priority" type="tns:CasePriority" use="required"/><xs:attribute name="owner" type="xs:string"/><xs:attribute name="openedAt" type="xs:dateTime" use="required"/></xs:complexType>
  <xs:element name="case" type="tns:CaseType"><xs:annotation><xs:documentation>Support case export or update.</xs:documentation></xs:annotation></xs:element>
</xs:schema>