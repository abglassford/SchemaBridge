<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="https://schemas.example.test/healthcare/v1" targetNamespace="https://schemas.example.test/healthcare/v1" elementFormDefault="qualified">
  <xs:annotation><xs:documentation>Patient visit summaries and clinical observations.</xs:documentation></xs:annotation>
  <xs:simpleType name="PatientId"><xs:annotation><xs:documentation>Pseudonymous patient identifier.</xs:documentation></xs:annotation><xs:restriction base="xs:string"><xs:pattern value="PT-[A-F0-9]{10}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="VisitKind"><xs:annotation><xs:documentation>Clinical encounter category.</xs:documentation></xs:annotation><xs:restriction base="xs:string"><xs:enumeration value="consultation"/><xs:enumeration value="followUp"/><xs:enumeration value="urgent"/></xs:restriction></xs:simpleType>
  <xs:complexType name="ObservationType"><xs:annotation><xs:documentation>Single measured observation with unit.</xs:documentation></xs:annotation><xs:sequence><xs:element name="code" type="xs:string"><xs:annotation><xs:documentation>Clinical vocabulary code.</xs:documentation></xs:annotation></xs:element><xs:element name="value" type="xs:decimal"/><xs:element name="unit" type="xs:string"/></xs:sequence><xs:attribute name="measuredAt" type="xs:dateTime" use="required"/><xs:attribute name="flag" type="xs:string" default="normal"/></xs:complexType>
  <xs:complexType name="VisitType"><xs:annotation><xs:documentation>Encounter metadata and recorded observations.</xs:documentation></xs:annotation><xs:sequence><xs:element name="patient" type="tns:PatientId"/><xs:element name="provider" type="xs:string"/><xs:element name="summary" type="xs:string"><xs:annotation><xs:documentation>Clinician-authored visit summary.</xs:documentation></xs:annotation></xs:element><xs:element name="observation" type="tns:ObservationType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence><xs:attribute name="kind" type="tns:VisitKind" use="required"/><xs:attribute name="visitDate" type="xs:date" use="required"/><xs:attribute name="confidential" type="xs:boolean" default="true"/></xs:complexType>
  <xs:element name="visit" type="tns:VisitType"><xs:annotation><xs:documentation>De-identified visit summary transfer.</xs:documentation></xs:annotation></xs:element>
</xs:schema>