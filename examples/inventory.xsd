<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="https://schemas.example.test/inventory/v1" targetNamespace="https://schemas.example.test/inventory/v1" elementFormDefault="qualified">
  <xs:annotation><xs:documentation>Warehouse stock, location, and replenishment records.</xs:documentation></xs:annotation>
  <xs:simpleType name="WarehouseCode"><xs:annotation><xs:documentation>Internal warehouse location code.</xs:documentation></xs:annotation><xs:restriction base="xs:string"><xs:pattern value="WH-[A-Z]{2}-[0-9]{3}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="StockCondition"><xs:annotation><xs:documentation>Physical stock condition.</xs:documentation></xs:annotation><xs:restriction base="xs:string"><xs:enumeration value="sellable"/><xs:enumeration value="reserved"/><xs:enumeration value="damaged"/></xs:restriction></xs:simpleType>
  <xs:complexType name="BinType"><xs:annotation><xs:documentation>Warehouse aisle, rack, and bin address.</xs:documentation></xs:annotation><xs:sequence><xs:element name="aisle" type="xs:string"/><xs:element name="rack" type="xs:string"/><xs:element name="bin" type="xs:string"><xs:annotation><xs:documentation>Smallest addressable storage unit.</xs:documentation></xs:annotation></xs:element></xs:sequence><xs:attribute name="zone" type="xs:string" use="required"/><xs:attribute name="temperatureControlled" type="xs:boolean" default="false"/></xs:complexType>
  <xs:complexType name="StockItemType"><xs:annotation><xs:documentation>On-hand quantity for an item at one warehouse.</xs:documentation></xs:annotation><xs:sequence><xs:element name="sku" type="xs:string"/><xs:element name="quantity" type="xs:nonNegativeInteger"><xs:annotation><xs:documentation>Available physical units.</xs:documentation></xs:annotation></xs:element><xs:element name="reorderPoint" type="xs:nonNegativeInteger"/><xs:element name="bin" type="tns:BinType"/></xs:sequence><xs:attribute name="warehouse" type="tns:WarehouseCode" use="required"/><xs:attribute name="condition" type="tns:StockCondition" use="required"/><xs:attribute name="countedAt" type="xs:dateTime"/></xs:complexType>
  <xs:element name="stockItem" type="tns:StockItemType"><xs:annotation><xs:documentation>Inventory snapshot for one stock item.</xs:documentation></xs:annotation></xs:element>
</xs:schema>