<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="https://schemas.example.test/identity/v1" targetNamespace="https://schemas.example.test/identity/v1" elementFormDefault="qualified">
  <xs:annotation><xs:documentation>Identity profiles, credentials, and access grants.</xs:documentation></xs:annotation>
  <xs:simpleType name="PrincipalId"><xs:annotation><xs:documentation>Globally unique principal identifier.</xs:documentation></xs:annotation><xs:restriction base="xs:string"><xs:pattern value="ID-[A-Z0-9]{12}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="AccessLevel"><xs:annotation><xs:documentation>Access grant scope.</xs:documentation></xs:annotation><xs:restriction base="xs:string"><xs:enumeration value="read"/><xs:enumeration value="write"/><xs:enumeration value="admin"/></xs:restriction></xs:simpleType>
  <xs:complexType name="CredentialType"><xs:annotation><xs:documentation>Credential metadata; secret material is never included.</xs:documentation></xs:annotation><xs:sequence><xs:element name="credentialId" type="xs:string"/><xs:element name="issuedAt" type="xs:dateTime"/><xs:element name="expiresAt" type="xs:dateTime" minOccurs="0"/></xs:sequence><xs:attribute name="kind" type="xs:string" use="required"/><xs:attribute name="revoked" type="xs:boolean" default="false"/></xs:complexType>
  <xs:complexType name="PrincipalType"><xs:annotation><xs:documentation>Identity profile and assigned authorization level.</xs:documentation></xs:annotation><xs:sequence><xs:element name="id" type="tns:PrincipalId"/><xs:element name="displayName" type="xs:string"/><xs:element name="email" type="xs:string"/><xs:element name="credential" type="tns:CredentialType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence><xs:attribute name="access" type="tns:AccessLevel" use="required"/><xs:attribute name="enabled" type="xs:boolean" default="true"/><xs:attribute name="tenant" type="xs:string" use="required"/></xs:complexType>
  <xs:element name="principal" type="tns:PrincipalType"><xs:annotation><xs:documentation>Identity profile synchronization record.</xs:documentation></xs:annotation></xs:element>
</xs:schema>