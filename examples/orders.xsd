<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="https://schemas.example.test/orders/v1" targetNamespace="https://schemas.example.test/orders/v1" elementFormDefault="qualified">
  <xs:annotation><xs:documentation>Sales orders, line items, and fulfillment intent.</xs:documentation></xs:annotation>
  <xs:simpleType name="OrderNumber"><xs:annotation><xs:documentation>Human-readable order reference.</xs:documentation></xs:annotation><xs:restriction base="xs:string"><xs:pattern value="ORD-[0-9]{8}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="OrderState"><xs:annotation><xs:documentation>Order processing lifecycle.</xs:documentation></xs:annotation><xs:restriction base="xs:string"><xs:enumeration value="pending"/><xs:enumeration value="confirmed"/><xs:enumeration value="fulfilled"/><xs:enumeration value="cancelled"/></xs:restriction></xs:simpleType>
  <xs:complexType name="LineType"><xs:annotation><xs:documentation>One requested product and quantity.</xs:documentation></xs:annotation><xs:sequence><xs:element name="sku" type="xs:string"><xs:annotation><xs:documentation>Referenced catalog SKU.</xs:documentation></xs:annotation></xs:element><xs:element name="quantity" type="xs:positiveInteger"/><xs:element name="unitPrice" type="xs:decimal"/></xs:sequence><xs:attribute name="lineNo" type="xs:positiveInteger" use="required"/><xs:attribute name="gift" type="xs:boolean" default="false"/></xs:complexType>
  <xs:complexType name="OrderType"><xs:annotation><xs:documentation>Order header and one or more purchase lines.</xs:documentation></xs:annotation><xs:sequence><xs:element name="number" type="tns:OrderNumber"/><xs:element name="placedAt" type="xs:dateTime"/><xs:element name="line" type="tns:LineType" maxOccurs="unbounded"><xs:annotation><xs:documentation>Ordered products in display order.</xs:documentation></xs:annotation></xs:element><xs:element name="note" type="xs:string" minOccurs="0"/></xs:sequence><xs:attribute name="state" type="tns:OrderState" use="required"/><xs:attribute name="customerRef" type="xs:string" use="required"/><xs:attribute name="channel" type="xs:string" default="online"/></xs:complexType>
  <xs:element name="order" type="tns:OrderType"><xs:annotation><xs:documentation>Order submission or status snapshot.</xs:documentation></xs:annotation></xs:element>
</xs:schema>